from typing import Any, Dict, List, Optional, Set, Tuple, Union

DEBUG = False
DEFAULT_CACHE_DIR = "~/.cache/sbgen"
DEFAULT_DEFAULT_DIRECT = True
DEFAULT_FINAL_OUTBOUND = "direct"
DEFAULT_BLOCK_OUTBOUND = "block"
DEFAULT_URL_TIMEOUT = 30
DEFAULT_USER_AGENT = "sbgen/1.0"
# Reserved YAML profile tid for interface-agnostic routing (%%DEFAULTS%%).
# In YAML the key must be quoted: "-":
DEFAULT_PROFILE_TID = "-"

def debug_print(msg: str):
    if DEBUG:
        print(f">> {msg}", file=sys.stderr)

def _redact_proxy_url(url: str) -> str:
    """Mask userinfo in proxy URL for logging."""
    if not url or "@" not in url:
        return url
    try:
        p = urlsplit(url)
        if "@" not in p.netloc:
            return url
        _, _, hostport = p.netloc.rpartition("@")
        netloc = "***:***@" + hostport if hostport else p.netloc
        return urlunsplit((p.scheme, netloc, p.path, p.query, p.fragment))
    except Exception:
        return "(proxy url redacted)"

def _url_opener_from_env():
    """Opener that uses HTTP(S)_PROXY / ALL_PROXY / NO_PROXY from the environment."""
    return urllib.request.build_opener(urllib.request.ProxyHandler())

def _log_proxy_env_if_verbose():
    if not DEBUG:
        return
    proxies = urllib.request.getproxies()
    if not proxies:
        debug_print("Proxies: (none from environment; set HTTP_PROXY/HTTPS_PROXY if needed)")
        return
    for scheme, u in sorted(proxies.items()):
        debug_print(f"Proxy[{scheme}] = {_redact_proxy_url(u)}")

# ---------- input normalization ----------
def norm_list(x):
    if x is None:
        return []
    if isinstance(x, list):
        return x
    return [x]

def norm_bool(x, default=DEFAULT_DEFAULT_DIRECT):
    if x is None:
        return bool(default)
    return bool(x)

# ---------- patterns loader ----------
def _strip_inline_comment(line: str) -> str:
    out = []
    escaped = False
    for ch in line:
        if ch == '#' and not escaped:
            break
        if ch == '\\' and not escaped:
            escaped = True
        else:
            out.append(ch)
            escaped = False
    return "".join(out).strip()

def load_patterns_from_file(file_path: str) -> List[str]:
    pats: List[str] = []
    with open(file_path, "r", encoding="utf-8") as f:
        for ln, line in enumerate(f, 1):
            raw = line.strip()
            if not raw or raw.startswith("#"):
                continue
            cl = _strip_inline_comment(line).strip()
            if cl:
                pats.append(cl)
            else:
                debug_print(f"{file_path}:{ln} comment only")
    return pats

# ---------- include path resolution ----------
def resolve_include_path(include: str, item_base: Optional[str], tid_base: Optional[str], cli_base: Optional[str]) -> Optional[str]:
    if os.path.isabs(include):
        return include if os.path.isfile(include) else None

    for base in [item_base, tid_base, cli_base, os.getcwd()]:
        if base:
            c = os.path.join(base, include)
            if os.path.isfile(c):
                return os.path.abspath(c)

    debug_print(f"Include not found: {include}")
    return None

def collect_included_patterns(includes_field, item_base, tid_base, cli_base):
    out: List[str] = []
    for inc in norm_list(includes_field):
        if not isinstance(inc, str):
            continue
        p = resolve_include_path(inc, item_base, tid_base, cli_base)
        if not p:
            continue
        try:
            pats = load_patterns_from_file(p)
            debug_print(f"Loaded {len(pats)} patterns from include '{p}'")
            out.extend(pats)
        except Exception as e:
            debug_print(f"Failed to load include '{p}': {e}")
    return out

def _parse_pattern_text(text: str) -> List[str]:
    """Parse raw text as list of patterns (same format as include files)."""
    pats: List[str] = []
    for line in text.splitlines():
        raw = line.strip()
        if not raw or raw.startswith("#"):
            continue
        cl = _strip_inline_comment(line).strip()
        if cl:
            pats.append(cl)
    return pats

def load_patterns_from_url(url: str, cache_dir: str, refresh: bool) -> List[str]:
    """Fetch list from URL with file cache; on fetch error use existing cache if present."""
    try:
        digest = hashlib.sha256(url.encode()).hexdigest()
    except Exception:
        digest = hashlib.sha256(url.encode("utf-8")).hexdigest()
    cache_path = os.path.join(cache_dir, digest + ".txt")

    if not refresh and os.path.isfile(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8") as f:
                data = f.read()
            pats = _parse_pattern_text(data)
            debug_print(f"Loaded {len(pats)} patterns from cache for '{url}'")
            return pats
        except Exception as e:
            debug_print(f"Cache read failed for '{url}': {e}")

    try:
        req = urllib.request.Request(url, headers={"User-Agent": DEFAULT_USER_AGENT})
        opener = _url_opener_from_env()
        with opener.open(req, timeout=DEFAULT_URL_TIMEOUT) as resp:
            data = resp.read().decode("utf-8", errors="replace")
        os.makedirs(cache_dir, exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            f.write(data)
        pats = _parse_pattern_text(data)
        debug_print(f"Loaded {len(pats)} patterns from URL '{url}'")
        return pats
    except Exception as e:
        if os.path.isfile(cache_path):
            try:
                with open(cache_path, "r", encoding="utf-8") as f:
                    data = f.read()
                pats = _parse_pattern_text(data)
                print(f"URL fetch failed ({url}), using cache: {e}", file=sys.stderr)
                debug_print(f"Loaded {len(pats)} patterns from cache for '{url}'")
                return pats
            except Exception as e2:
                print(f"URL fetch failed ({url}): {e}; cache read failed: {e2}", file=sys.stderr)
                return []
        else:
            print(f"URL fetch failed ({url}): {e}", file=sys.stderr)
            return []

def collect_url_patterns(urls_field, cache_dir: str, refresh: bool) -> List[str]:
    out: List[str] = []
    for u in norm_list(urls_field):
        if not isinstance(u, str):
            continue
        out.extend(load_patterns_from_url(u, cache_dir, refresh))
    return out

# ---------- classify patterns ----------
_WILD_ANY_LABEL = r"[^.]*"

def classify_pattern(p: Optional[str]):
    if not p:
        return None
    p = p.strip()
    if not p:
        return None

    try:
        network = ipaddress.ip_network(p, strict=False)
        return ("cidr", str(network))
    except ValueError:
        pass

    p = p.lower()
    if p.startswith("*.") and len(p) > 2:
        return ("suffix", p[2:])
    if p.startswith(".") and len(p) > 1:
        return ("suffix", p[1:])
    if p.endswith(".*") and not p.startswith("*"):
        b = p[:-2]
        if b:
            rx = rf"^(.+\.)?{re.escape(b)}\.[^.]+$"
            return ("regex", rx)

    if "*" in p:
        rx = re.escape(p).replace(r"\*", _WILD_ANY_LABEL)
        return ("regex", rf"^{rx}$")

    return ("suffix", p)

def split_patterns(patterns) -> Tuple[List[str], List[str]]:
    domain_list: List[str] = []
    cidr_list: List[str] = []
    cidr_seen: Set[str] = set()
    for raw in norm_list(patterns):
        if not isinstance(raw, str):
            continue
        c = classify_pattern(raw)
        if not c:
            continue
        kind, val = c
        if kind == "cidr":
            if val not in cidr_seen:
                cidr_seen.add(val)
                cidr_list.append(val)
        else:
            domain_list.append(raw)
    return (domain_list, cidr_list)

# ---------- inbound spec (%%tid:in1,in2#d6%%) ----------
InboundEntry = Tuple[str, Set[str]]
InboundField = Optional[Union[str, List[str]]]

def parse_inbound_spec(spec: str) -> List[InboundEntry]:
    """Parse 'in-a,in-b#d6' into [(name, flags), ...]."""
    out: List[InboundEntry] = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        bits = part.split("#")
        name = bits[0].strip()
        if not name:
            continue
        flags = {b.strip().lower() for b in bits[1:] if b.strip()}
        out.append((name, flags))
    return out

def inbound_field(tags: Optional[List[str]]) -> InboundField:
    """None / single string / list of tags for sing-box inbound field."""
    if not tags:
        return None
    if len(tags) == 1:
        return tags[0]
    return list(tags)

def _apply_inbound(rule: Dict[str, Any], inbound: InboundField, xray_mode: bool) -> None:
    if not inbound:
        return
    tags = inbound if isinstance(inbound, list) else [inbound]
    if xray_mode:
        rule["inboundTag"] = list(tags)
    else:
        rule["inbound"] = tags[0] if len(tags) == 1 else list(tags)

def split_cidrs_v4_v6(cidr_list: List[str]) -> Tuple[List[str], List[str]]:
    v4: List[str] = []
    v6: List[str] = []
    for c in cidr_list:
        try:
            net = ipaddress.ip_network(c, strict=False)
        except ValueError:
            continue
        if net.version == 6:
            v6.append(c)
        else:
            v4.append(c)
    return v4, v6

# ---------- rules ----------
def generate_rules(inbound: InboundField, patterns, outbound: str, xray_mode: bool, block_as_action: bool = False):
    suf: List[str] = []
    reg: List[str] = []
    ss, sr = set(), set()

    for raw in norm_list(patterns):
        c = classify_pattern(raw)
        if not c:
            continue
        kind, val = c
        if kind == "cidr":
            continue
        if kind == "suffix":
            val = val.lstrip(".")
            if val not in ss:
                ss.add(val)
                suf.append(val)
        else:
            if val not in sr:
                sr.add(val)
                reg.append(val)

    if not suf and not reg:
        return []

    if xray_mode:
        # Xray / V2Ray style
        r: Dict[str, Any] = {
            "type": "field",
            "outboundTag": outbound,
        }
        _apply_inbound(r, inbound, True)
        if suf:
            r["domainSuffix"] = suf
        if reg:
            r["domainRegex"] = reg
    else:
        # sing-box style
        if block_as_action and outbound == DEFAULT_BLOCK_OUTBOUND:
            r = {"action": "reject"}
        else:
            r = {"outbound": outbound}
        _apply_inbound(r, inbound, False)
        if suf:
            r["domain_suffix"] = suf
        if reg:
            r["domain_regex"] = reg

    return [r]

def generate_cidr_rules(inbound: InboundField, cidr_list: List[str], outbound: str, xray_mode: bool, block_as_action: bool = False) -> List[Dict[str, Any]]:
    if not cidr_list:
        return []
    if xray_mode:
        r: Dict[str, Any] = {
            "type": "field",
            "outboundTag": outbound,
            "ip": list(cidr_list),
        }
        _apply_inbound(r, inbound, True)
        return [r]
    if block_as_action and outbound == DEFAULT_BLOCK_OUTBOUND:
        base: Dict[str, Any] = {"action": "reject"}
    else:
        base = {"outbound": outbound}
    _apply_inbound(base, inbound, False)
    base["ip_cidr"] = list(cidr_list)
    return [base]

def generate_direct6_preamble(d6_tags: List[str], resolve6: Optional[str], list_name: str) -> List[Dict[str, Any]]:
    """Resolve prefer_ipv6 + ::/0 → direct for each #d6 inbound (sing-box only)."""
    if not d6_tags:
        return []
    if not isinstance(resolve6, str) or not resolve6.strip():
        print(
            f"direct6 set but resolve6 missing/empty for list {list_name!r}; skipping resolve rules",
            file=sys.stderr,
        )
        resolve_server = None
    else:
        resolve_server = resolve6.strip()

    rules: List[Dict[str, Any]] = []
    for tag in d6_tags:
        if resolve_server:
            rules.append({
                "inbound": tag,
                "server": resolve_server,
                "strategy": "prefer_ipv6",
                "action": "resolve",
            })
        rules.append({
            "inbound": tag,
            "ip_cidr": ["::/0"],
            "action": "route",
            "outbound": DEFAULT_FINAL_OUTBOUND,
        })
    return rules

# ---------- sanitize trailing commas ----------
def _sanitize_trailing_commas(s: str) -> str:
    s = re.sub(r',\s*([\]}])', r'\1', s)
    s = re.sub(r'([\[{])\s*,', r'\1', s)
    s = re.sub(r',\s*,', ',', s)
    s = re.sub(r'\[\s*,\s*\]', '[]', s)
    s = re.sub(r'\{\s*,\s*\}', '{}', s)
    return s

# ---------- placeholders ----------
# %%tid:inbounds%%  or  %%tid(out1,out2):inbounds%%
_PLACEH_RX = r'%%([^%(:\s]+)(?:\(([^%]*)\))?:([^%]+)%%'
_FINAL_TOKEN = "%%FINAL%%"
# %%DEFAULTS%%  or  %%DEFAULTS(out1,out2)%%
_DEFAULTS_RX = r'%%DEFAULTS(?:\(([^%]*)\))?%%'
_DEFAULTS_TOKEN = "%%DEFAULTS%%"

def parse_outbound_list(s: Optional[str]) -> List[str]:
    """Split comma-separated outbound tags; trim; drop empties; preserve order, unique."""
    if not s:
        return []
    out: List[str] = []
    seen: Set[str] = set()
    for part in s.split(","):
        t = part.strip()
        if t and t not in seen:
            seen.add(t)
            out.append(t)
    return out

def merge_outbound_tags(base: List[str], *extra_lists: List[str]) -> List[str]:
    seen = set(base)
    out = list(base)
    for lst in extra_lists:
        for t in lst:
            if isinstance(t, str) and t and t not in seen:
                seen.add(t)
                out.append(t)
    return out

def collect_declared_outs_from_placeholders(placeholders: List[str]) -> List[str]:
    declared: List[str] = []
    seen: Set[str] = set()
    for tok in placeholders:
        m = re.fullmatch(_DEFAULTS_RX, tok)
        if m:
            for t in parse_outbound_list(m.group(1)):
                if t not in seen:
                    seen.add(t)
                    declared.append(t)
            continue
        m = re.fullmatch(_PLACEH_RX, tok)
        if not m:
            continue
        for t in parse_outbound_list(m.group(2)):
            if t not in seen:
                seen.add(t)
                declared.append(t)
    return declared

def _quote_unquoted_placeholders(text: str) -> str:
    text = re.sub(r'(?<!")(' + _PLACEH_RX + r')(?!")', r'"\1"', text)
    text = re.sub(r'(?<!")(' + re.escape(_FINAL_TOKEN) + r')(?!")', r'"\1"', text)
    text = re.sub(r'(?<!")(' + _DEFAULTS_RX + r')(?!")', r'"\1"', text)
    return text

def _find_placeholders(node):
    f = []
    if isinstance(node, str):
        if re.fullmatch(_PLACEH_RX, node) or node == _FINAL_TOKEN or re.fullmatch(_DEFAULTS_RX, node):
            f.append(node)
    elif isinstance(node, list):
        for i in node:
            f += _find_placeholders(i)
    elif isinstance(node, dict):
        for v in node.values():
            f += _find_placeholders(v)
    return f

# ---------- outbounds detection ----------
def collect_available_out_tags(tpl_json, xray_mode: bool):
    tags = []
    seen = set()

    # Currently outbounds syntax is the same, just collect .tag
    arr = tpl_json.get("outbounds") or []
    for ob in arr:
        if isinstance(ob, dict):
            tag = ob.get("tag")
            if isinstance(tag, str) and tag not in seen:
                seen.add(tag)
                tags.append(tag)
    return tags

# ---------- pick FINAL ----------
def pick_final(config, tid: Optional[str], available: Set[str]):
    if not tid or tid not in config:
        return DEFAULT_FINAL_OUTBOUND
    cfg = config[tid]
    if cfg.get("default_direct", DEFAULT_DEFAULT_DIRECT):
        return DEFAULT_FINAL_OUTBOUND

    for lst in cfg.get("lists", []):
        outs = norm_list(lst.get("out"))
        for o in outs:
            if o in available:
                return o

    return DEFAULT_FINAL_OUTBOUND

# ---------- AST replacement ----------
def ast_replace(node, rules_by_token, final_value):
    if isinstance(node, list):
        out = []
        for i in node:
            if isinstance(i, str) and i in rules_by_token:
                out.extend(rules_by_token[i])
            else:
                out.append(ast_replace(i, rules_by_token, final_value))
        return out

    if isinstance(node, dict):
        return {k: ast_replace(v, rules_by_token, final_value) for k,v in node.items()}

    if isinstance(node, str):
        if node == _FINAL_TOKEN and final_value is not None:
            return final_value
        return node

    return node

# ---------- main ----------
def main():
    global DEBUG

    ap = argparse.ArgumentParser(description="Generate sing-box/xray JSON from template + YAML config(s).")
    ap.add_argument("template", help="Path to JSON template with placeholders like %%tid(out1):in1,in2#d6%% or %%DEFAULTS%% (quoted or bare)")
    ap.add_argument("yamls", nargs="+", help="One or more YAML files with rules")
    ap.add_argument("-v","--verbose", action="store_true", help="Enable debug logging to stderr")
    ap.add_argument("-b","--base-dir", dest="cli_base_dir", default=None,
                    help="Optional base directory for resolving relative 'includes' (used after item/tid base dirs)")
    ap.add_argument("-a","--append", dest="append_rule",
                    help="Append raw fragment (string or JSON) into route/routing.rules[] before placeholder processing")
    ap.add_argument("-o","--outbound", dest="assume_outbounds", action="append", default=[],
                    help="Declare outbound tag(s) present in another config fragment (comma-separated; repeatable)")
    ap.add_argument("-x","--xray", action="store_true", help="Xray mode")
    ap.add_argument("-c","--cache-dir", dest="cache_dir", default=DEFAULT_CACHE_DIR,
                    help="Directory for caching URL list downloads (default: %(default)s)")
    ap.add_argument("-r","--refresh", action="store_true",
                    help="Force re-download of URL lists (fallback to cache on failure)")
    args = ap.parse_args()
    args.cache_dir = os.path.expanduser(args.cache_dir)

    DEBUG = args.verbose

    cli_outs: List[str] = []
    for item in args.assume_outbounds:
        cli_outs.extend(parse_outbound_list(item))

    if DEBUG:
        _log_proxy_env_if_verbose()
        debug_print(f"Template: {args.template}")
        debug_print(f"YAML files: {args.yamls}")
        debug_print(f"CLI base_dir: {args.cli_base_dir or '(none)'}")
        debug_print(f"CLI assume outbounds: {cli_outs or '(none)'}")
        debug_print(f"Cache dir: {args.cache_dir} refresh={args.refresh}")
        debug_print(f"Mode: {'xray' if args.xray else 'sing-box'}")

    # load template
    if not os.path.isfile(args.template):
        print("Template not found", file=sys.stderr); sys.exit(1)

    txt = open(args.template,"r",encoding="utf-8").read()
    txt = _sanitize_trailing_commas(txt)
    txt = _quote_unquoted_placeholders(txt)

    try:
        tpl_json = json.loads(txt)
    except json.JSONDecodeError as e:
        print(f"JSON error: {e}", file=sys.stderr)
        sys.exit(1)

    # -------- append raw fragment into template BEFORE placeholder processing --------
    if args.append_rule:
        section = "routing" if args.xray else "route"
        if section not in tpl_json or "rules" not in tpl_json[section] or not isinstance(tpl_json[section]["rules"], list):
            print(f"Cannot append: section '{section}.rules' not found or not a list", file=sys.stderr)
        else:
            rules_list = tpl_json[section]["rules"]
            raw = args.append_rule
            try:
                parsed = json.loads(raw)
            except Exception:
                # treat as raw string (e.g. '%%russia:in-extra%%')
                rules_list.append(raw)
                debug_print(f"Appended raw string from -a into {section}.rules: {raw}")
            else:
                if isinstance(parsed, list):
                    rules_list.extend(parsed)
                    debug_print(f"Appended {len(parsed)} JSON rule(s) from -a into {section}.rules")
                else:
                    rules_list.append(parsed)
                    debug_print(f"Appended 1 JSON rule from -a into {section}.rules")

    available_tags_list = collect_available_out_tags(tpl_json, args.xray)
    # has_block_outbound / block_as_action finalized after placeholder + CLI merge below

    # -------- YAML merge --------
    config: Dict[str, Dict[str, Any]] = {}
    tid_base: Dict[str, Optional[str]] = {}
    direct_bases: Dict[str, List[str]] = {}
    block_bases: Dict[str, List[str]] = {}

    for path in args.yamls:
        data = yaml.safe_load(open(path,"r",encoding="utf-8")) or {}
        base = os.path.dirname(os.path.abspath(path))

        debug_print(f"Loaded YAML: {os.path.basename(path)} (file_base={base})")

        for tid, sec in data.items():
            if tid not in config:
                config[tid] = {"lists":[], "direct":[], "blocked":[], "default_direct": DEFAULT_DEFAULT_DIRECT}
                tid_base[tid] = None
                direct_bases[tid] = []
                block_bases[tid] = []
                debug_print(f"New tid: {tid}")

            cfg = config[tid]

            if isinstance(sec, dict) and "base_dir" in sec and sec["base_dir"]:
                b = sec["base_dir"]
                tid_base[tid] = b if os.path.isabs(b) else os.path.abspath(os.path.join(base,b))
                debug_print(f"{tid}: base_dir set to {tid_base[tid]}")

            # lists
            for lst in sec.get("lists") or []:
                if isinstance(lst, dict):
                    obj = dict(lst)
                    obj["__base_dir"] = base
                    cfg["lists"].append(obj)

            # direct
            dsrc = sec.get("direct")
            if isinstance(dsrc, list):
                for it in dsrc:
                    if isinstance(it, dict):
                        o = dict(it); o["__base_dir"] = base; cfg["direct"].append(o)
                    else:
                        cfg["direct"].append(it)
                    direct_bases[tid].append(base)
            elif dsrc is not None:
                if isinstance(dsrc, dict):
                    o = dict(dsrc); o["__base_dir"] = base; cfg["direct"].append(o)
                else:
                    cfg["direct"].append(dsrc)
                direct_bases[tid].append(base)

            # blocked / block
            bsrc = sec.get("blocked") or sec.get("block")
            if isinstance(bsrc, list):
                for it in bsrc:
                    if isinstance(it, dict):
                        o = dict(it); o["__base_dir"] = base; cfg["blocked"].append(o)
                    else:
                        cfg["blocked"].append(it)
                    block_bases[tid].append(base)
            elif bsrc is not None:
                if isinstance(bsrc, dict):
                    o = dict(bsrc); o["__base_dir"] = base; cfg["blocked"].append(o)
                else:
                    cfg["blocked"].append(bsrc)
                block_bases[tid].append(base)

            cfg["default_direct"] = norm_bool(sec.get("default_direct"), default=cfg["default_direct"])

            debug_print(
                f"{tid}: lists={len(cfg['lists'])} direct={len(cfg['direct'])} "
                f"blocked={len(cfg['blocked'])} default_direct={cfg['default_direct']}"
            )

    # -------- find placeholders --------
    placeholders = _find_placeholders(tpl_json)
    debug_print(f"Placeholders in AST (order): {placeholders}")

    ph_outs = collect_declared_outs_from_placeholders(placeholders)
    available_tags_list = merge_outbound_tags(available_tags_list, cli_outs, ph_outs)
    available_tags = set(available_tags_list)
    has_block_outbound = DEFAULT_BLOCK_OUTBOUND in available_tags
    block_as_action = not has_block_outbound and not args.xray
    debug_print(f"Declared outs from placeholders: {ph_outs or '(none)'}")
    debug_print(f"Available outbound tags: {available_tags_list}")
    debug_print(f"Block as action: {block_as_action} (has_block_outbound={has_block_outbound})")

    def build_rules_for_profile(
        tid: str,
        inbound_entries: Optional[List[InboundEntry]],
    ) -> List[Dict[str, Any]]:
        if tid not in config:
            return []

        sec = config[tid]
        rules: List[Dict[str, Any]] = []

        if inbound_entries is None:
            # %%DEFAULTS%% — no inbound binding, no #d6 branch
            all_tags: Optional[List[str]] = None
            d6_tags: List[str] = []
            non_d6_tags: List[str] = []
            inbound_all: InboundField = None
        else:
            all_tags = [name for name, _ in inbound_entries]
            d6_tags = [name for name, flags in inbound_entries if "d6" in flags]
            non_d6_tags = [name for name, flags in inbound_entries if "d6" not in flags]
            inbound_all = inbound_field(all_tags)

        # lists
        for lst in sec["lists"]:
            item_base = lst.get("__base_dir")
            pats: List[str] = []
            pats += collect_included_patterns(lst.get("includes"), item_base, tid_base.get(tid), args.cli_base_dir)
            pats += collect_url_patterns(lst.get("urls"), args.cache_dir, args.refresh)
            pats += norm_list(lst.get("patterns"))
            domain_pats, cidr_pats = split_patterns(pats)
            outs = norm_list(lst.get("out"))
            available_outs = [o for o in outs if isinstance(o, str) and o in available_tags]
            for o in outs:
                if not isinstance(o, str) or o not in available_tags:
                    debug_print(f"Skip list out='{o}' (not present in template outbounds)")

            list_name = lst.get("name") if isinstance(lst.get("name"), str) else "(unnamed)"
            direct6 = norm_bool(lst.get("direct6"), default=False)
            resolve6 = lst.get("resolve6")
            use_direct6 = (
                direct6
                and not args.xray
                and inbound_entries is not None
                and bool(d6_tags)
            )

            if direct6 and args.xray:
                debug_print(f"list {list_name!r}: direct6/#d6 skipped in xray mode")

            if use_direct6:
                rules.extend(generate_direct6_preamble(d6_tags, resolve6 if isinstance(resolve6, str) else None, list_name))
                v4_cidrs, v6_cidrs = split_cidrs_v4_v6(cidr_pats)
                inbound_v6 = inbound_field(non_d6_tags)
                for o in available_outs:
                    rules.extend(generate_cidr_rules(inbound_all, v4_cidrs, o, args.xray, block_as_action))
                    rules.extend(generate_cidr_rules(inbound_v6, v6_cidrs, o, args.xray, block_as_action))
                    rules.extend(generate_rules(inbound_all, domain_pats, o, args.xray, block_as_action))
            else:
                for o in available_outs:
                    # CIDR before domains (matches inout-split expected order)
                    rules.extend(generate_cidr_rules(inbound_all, cidr_pats, o, args.xray, block_as_action))
                    rules.extend(generate_rules(inbound_all, domain_pats, o, args.xray, block_as_action))

        # direct
        dp: List[str] = []
        src = sec["direct"]
        bases = direct_bases[tid]
        if isinstance(src, list):
            for it, ib in zip(src, bases):
                item = it
                if isinstance(item, dict):
                    ib = item.get("__base_dir", ib)
                    dp += collect_included_patterns(item.get("includes"),
                                                   ib, tid_base.get(tid), args.cli_base_dir)
                    dp += collect_url_patterns(item.get("urls"), args.cache_dir, args.refresh)
                    dp += norm_list(item.get("patterns"))
                else:
                    dp.append(item)

        # blocked
        bp: List[str] = []
        src = sec["blocked"]
        bases = block_bases[tid]
        if isinstance(src, list):
            for it, ib in zip(src, bases):
                item = it
                if isinstance(item, dict):
                    ib = item.get("__base_dir", ib)
                    bp += collect_included_patterns(item.get("includes"),
                                                   ib, tid_base.get(tid), args.cli_base_dir)
                    bp += collect_url_patterns(item.get("urls"), args.cache_dir, args.refresh)
                    bp += norm_list(item.get("patterns"))
                else:
                    bp.append(item)

        domain_dp, cidr_dp = split_patterns(dp)
        domain_bp, cidr_bp = split_patterns(bp)
        rules.extend(generate_cidr_rules(inbound_all, cidr_dp, DEFAULT_FINAL_OUTBOUND, args.xray))
        rules.extend(generate_rules(inbound_all, domain_dp, DEFAULT_FINAL_OUTBOUND, args.xray))
        rules.extend(generate_cidr_rules(inbound_all, cidr_bp, DEFAULT_BLOCK_OUTBOUND, args.xray, block_as_action))
        rules.extend(generate_rules(inbound_all, domain_bp, DEFAULT_BLOCK_OUTBOUND, args.xray, block_as_action))
        return rules

    # -------- build rules --------
    rules_by_ph: Dict[str, List[Dict[str, Any]]] = {}

    for tok in placeholders:
        md = re.fullmatch(_DEFAULTS_RX, tok)
        if md:
            rules = build_rules_for_profile(DEFAULT_PROFILE_TID, None)
            debug_print(f"{tok}: {len(rules)} rule(s) from tid={DEFAULT_PROFILE_TID!r} (no inbound)")
            rules_by_ph[tok] = rules
            continue

        m = re.fullmatch(_PLACEH_RX, tok)
        if not m:
            continue
        tid, spec = m.group(1), m.group(3)
        entries = parse_inbound_spec(spec)
        debug_print(f"{tok}: tid={tid!r} declared_outs={parse_outbound_list(m.group(2))} inbounds={[(n, sorted(f)) for n, f in entries]}")
        rules_by_ph[tok] = build_rules_for_profile(tid, entries)

    # -------- FINAL --------
    final_value = None
    if _FINAL_TOKEN in placeholders:
        first_tid = next(iter(config.keys()), None)
        final_value = pick_final(config, first_tid, available_tags)
        debug_print(f"FINAL picked: {final_value} from tid={first_tid}")

    # -------- apply AST replace --------
    out_ast = ast_replace(tpl_json, rules_by_ph, final_value)

    print(json.dumps(out_ast, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()

